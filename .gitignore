# Virtual Environment
.venv/
venv/
env/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# macOS metadata
.DS_Store
.AppleDouble
.LSOverride
._*

# Video and Media files (large binary assets)
*.mp4
*.webm
*.avi
*.mov
*.mkv
data/videos/*
!data/videos/.gitkeep

# Evidence snapshots & crops generated at runtime
data/evidence/*
!data/evidence/.gitkeep
data/autozone/*
data/zone_refs/*
violations_out/

# Database files
data/*.db
data/*.db-shm
data/*.db-wal
*.sqlite3

# Local test outputs & run logs
test_tracks.csv
tracks.csv
out*.mp4
speeds.csv

# Vision-language reasoner: multi-GB weights and the llama.cpp binaries (./tools/setup_vlm.sh fetches them)
models/vlm/*.gguf
models/vlm/*.sha256ok
vendor/

# Vehicle re-identification weights (~94 MB, trained in research/cityflow/): copy the notebook's reid_*.pth here
models/reid/*.pth

side1_1.mp4
side2_1.mp4

# Secrets: evidence-link signing key (surveillance/citation.py creates it) and local API keys
data/.media_secret
.env

# Team's raw footage drops (multi-GB zips) — upload through the dashboard, never commit
videos/


API

# ONNX exports of the vehicle detector (tools re-create them from the .pt)
models/bd_vehicles_*.onnx

# Per-instance VLM settings written by the admin page
data/vlm_settings.json
